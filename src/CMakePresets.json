{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ci-clang-tidy",
      "binaryDir": "${sourceDir}/../build-clang-tidy",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-clang-tidy",
      "configurePreset": "ci-clang-tidy",
      "targets": [
        "clang-tidy"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-clang-tidy",
      "steps": [
        {
          "type": "configure",
          "name": "ci-clang-tidy"
        },
        {
          "type": "build",
          "name": "ci-clang-tidy"
        }
      ]
    }
  ]
}
